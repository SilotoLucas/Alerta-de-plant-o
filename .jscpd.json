{
  "threshold": 0,
  "minTokens": 50,
  "minLines": 5,
  "absolute": false,
  "gitignore": true,
  "format": ["typescript", "tsx"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.reports/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/tools/quality/fixtures/**",
    "**/index.ts",
    "**/apps/android/**",
    "**/apps/windows/**"
  ]
}
