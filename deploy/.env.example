# Copie para deploy/.env na VM (o instalar.sh já faz isso e gera os segredos). Nunca commite o .env.
POSTGRES_PASSWORD=troque
# Senha de quem gera código de pareamento. Mínimo 16 caracteres.
PLANTAO_ADMIN_TOKEN=troque-por-um-segredo-longo
# Endereço público (HTTPS pelo Caddy da borda). Sem domínio próprio, use o sslip.io.
DOMINIO=plantao.194.5.152.64.sslip.io
COMPOSE_FILE=compose.yml:compose.borda.yml
# true: o aviso inclui o texto das mensagens (D22, decisão do dono). false: só a conversa e a quantidade (D11).
PLANTAO_ENVIAR_TEXTO=true
RETENCAO_EM_DIAS=7
