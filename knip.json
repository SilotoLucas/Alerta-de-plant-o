{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/coletor/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["fluxos/**/*.e2e.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "fluxos/**/*.ts"]
    },
    "apps/mobile": {
      "project": ["app/**/*.tsx", "src/**/*.{ts,tsx}"]
    },
    "tools/*": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": ["docs/design/**"]
}
