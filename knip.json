{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "tools/*": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": ["docs/design/**"]
}
