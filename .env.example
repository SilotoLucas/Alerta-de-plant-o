# Copie para .env (ignorado pelo git) e ajuste. A API recusa subir sem PLANTAO_ADMIN_TOKEN.
API_PORT=3350
DATABASE_URL=postgres://plantao:plantao@localhost:5435/plantao
# Senha de quem gera código de pareamento (header x-admin-token). Mínimo 16 caracteres.
PLANTAO_ADMIN_TOKEN=troque-por-um-segredo-longo
# false: o aviso mostra só o nome da conversa e a quantidade (D11). true: inclui o texto.
PLANTAO_ENVIAR_TEXTO=false
# true quando a API fica atrás do Caddy da borda (lê o IP real em x-forwarded-for).
CONFIAR_NO_PROXY=false
# Dias que o servidor guarda hashes de mensagens, avisos e códigos de pareamento vencidos.
RETENCAO_EM_DIAS=7
LIMITE_GERAL_POR_MINUTO=300
LIMITE_DE_PAREAMENTO_POR_MINUTO=5
